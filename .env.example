NODE_ENV=development
DATA_MODE=synthetic
# Obligatoires uniquement pour DATA_MODE=health en production, après contractualisation HDS v2.
HDS_PROVIDER=
HDS_CERTIFICATE_REFERENCE=
HDS_REGION=
DATABASE_URL=postgres://idel_app:idel_local_only@localhost:5432/idel_os
DATABASE_ADMIN_URL=postgres://idel_admin:idel_admin_local_only@localhost:5432/idel_os
DATABASE_AUTH_URL=postgres://idel_auth:idel_auth_local_only@localhost:5432/idel_os
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=idel-os-local
S3_ACCESS_KEY=idel_local
S3_SECRET_KEY=replace-for-local-development
IDEL_MASTER_KEY_BASE64=replace-with-32-random-bytes-encoded-as-base64
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3001
WEB_ORIGIN=http://localhost:3000
